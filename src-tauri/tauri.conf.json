{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ffyon Business Tracker",
  "version": "0.3.0",
  "identifier": "com.ffyon.tracker",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Ffyon Business Tracker",
        "width": 1280,
        "height": 820,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "endpoints": ["https://github.com/razorly/ffyon-business-tracker/releases/latest/download/latest.json"],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDMyODc0MDRGNEI1OEY4NTYKUldSVytGaExUMENITW96N1B1SU5mRHFsVU9tTUtOUjI0bjFKVmZRUndQK0VXb0hPTis4aFFjelMK"
    }
  }
}
